# Copy these names into Vercel Project Settings → Environment Variables.
# Do not commit real values or place server secrets in VITE_* variables.

# Required server configuration
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Required for the GitHub integration
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=

# Required only when Studio features use Manus Forge-backed storage, notifications, maps, voice, or data APIs
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Browser-visible configuration; never place secrets in these values
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
